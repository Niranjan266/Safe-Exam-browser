# Copy this file to ".env" and adjust for your environment.
# The app auto-loads .env on startup (via python-dotenv).

# Environment: development | production | testing
SEB_ENV=development

# IMPORTANT: set a long random value in production.
SEB_SECRET_KEY=change-me-to-a-long-random-string

# Database (defaults to a local SQLite file in ./instance/safeexam.db)
# SEB_DATABASE_URI=sqlite:///instance/safeexam.db
# SEB_DATABASE_URI=postgresql+psycopg://user:pass@localhost:5432/safeexam

# --- Turso / libSQL (used in production & on serverless hosts) ---
# When BOTH are set they take priority over SEB_DATABASE_URI.
# Never commit real values — set them in your host's environment settings.
# SEB_TURSO_URL=libsql://your-db.turso.io
# SEB_TURSO_TOKEN=your-auth-token

# Where live frames / webcam snapshots are kept: "disk" or "db".
# Must be "db" on read-only or serverless hosts (Vercel).
# SEB_FRAME_STORAGE=disk

# Allowed Host headers, comma separated (Flask equivalent of Django's
# ALLOWED_HOSTS). Empty = allow any host. Leading dot allows subdomains.
# SEB_ALLOWED_HOSTS=exam.niranjand.in,safe-exam-browser.vercel.app,localhost

# Create tables on startup. Set to 0 in serverless production once the schema
# exists (see scripts/init_db.py) to avoid slow cold starts.
# SEB_INIT_DB=1

# Send secure cookies (enable only when served over HTTPS)
SEB_SECURE_COOKIES=0

# --- Proctoring policy ---
SEB_MAX_VIOLATIONS=3
SEB_RISK_WINDOW_SECONDS=30
SEB_RISK_WINDOW_THRESHOLD=2
SEB_SNAPSHOT_INTERVAL=20
SEB_HEARTBEAT_TIMEOUT=20
