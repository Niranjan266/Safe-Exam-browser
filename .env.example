# Copy this file to ".env" and adjust for your environment.
# The app auto-loads .env on startup (via python-dotenv).

# Environment: development | production | testing
SEB_ENV=development

# IMPORTANT: set a long random value in production.
SEB_SECRET_KEY=change-me-to-a-long-random-string

# Database (defaults to a local SQLite file in ./instance/safeexam.db)
# SEB_DATABASE_URI=sqlite:///instance/safeexam.db
# SEB_DATABASE_URI=postgresql+psycopg://user:pass@localhost:5432/safeexam

# Send secure cookies (enable only when served over HTTPS)
SEB_SECURE_COOKIES=0

# --- Proctoring policy ---
SEB_MAX_VIOLATIONS=3
SEB_RISK_WINDOW_SECONDS=30
SEB_RISK_WINDOW_THRESHOLD=2
SEB_SNAPSHOT_INTERVAL=20
SEB_HEARTBEAT_TIMEOUT=20
